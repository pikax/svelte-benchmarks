{
  "name": "svelte-benchmarks",
  "version": "0.1.0",
  "private": true,
  "description": "Fair multi-tool benchmarks for Svelte compile, projection, typecheck, format, lint, metadata, LSP, and memory surfaces.",
  "keywords": [
    "benchmark",
    "compiler",
    "component-metadata",
    "lsp",
    "memory",
    "rsvelte",
    "svelte",
    "svelte-check",
    "svelte-check-rs",
    "svelte2tsx",
    "typecheck",
    "verter"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:small": "node scripts/generate.mjs --counts 50,200",
    "bench": "node scripts/bench.mjs",
    "bench:small": "node scripts/bench.mjs --fixture fixtures/50 --runs 2 --warmups 1",
    "bench:quick": "node scripts/bench.mjs --runs 3 --warmups 1",
    "bench:deep": "node scripts/bench.mjs --runs 9 --warmups 2",
    "bench:compile": "node scripts/bench.mjs --surfaces compile",
    "bench:compile:single": "node scripts/bench.mjs --fixture fixtures/20 --file-limit 1 --runs 9 --warmups 2 --surfaces compile",
    "bench:compile:repeated": "node scripts/bench.mjs --surfaces compile --fixture fixtures/50-repeated --compile-targets client --compile-envs production",
    "bench:projection": "node scripts/bench.mjs --surfaces projection",
    "bench:typecheck": "node scripts/bench.mjs --surfaces typecheck",
    "bench:format": "node scripts/bench.mjs --surfaces format",
    "bench:lint": "node scripts/bench.mjs --surfaces lint",
    "bench:lsp": "node scripts/bench.mjs --surfaces lsp --runs 3 --warmups 1",
    "bench:lsp-format": "node scripts/bench.mjs --surfaces lsp-format --runs 3 --warmups 1",
    "bench:component-meta": "node scripts/bench.mjs --surfaces component-meta",
    "bench:bundle": "node scripts/bench.mjs --surfaces bundle",
    "bench:hmr": "node scripts/bench.mjs --surfaces hmr",
    "bench:memory": "node --expose-gc scripts/bench-memory.mjs",
    "bench:memory:small": "node --expose-gc scripts/bench-memory.mjs --fixture fixtures/20 --file-limit 20 --samples 2",
    "fetch:real-world": "node scripts/fetch-real-world.mjs",
    "bench:real-world": "node scripts/bench-real-world.mjs",
    "bench:real-world:quick": "node scripts/bench-real-world.mjs --projects smui --file-limit 60 --runs 2 --warmups 1",
    "bench:real-world:smoke": "node scripts/bench-real-world.mjs --file-limit 5 --runs 1 --warmups 1",
    "bench:real-world:full": "node scripts/bench-real-world.mjs --runs 5 --warmups 1",
    "e2e:setup": "node scripts/e2e-vscode/setup-workspaces.mjs",
    "e2e:install-extensions": "node scripts/e2e-vscode/install-extensions.mjs",
    "e2e:vscode": "node scripts/e2e-vscode/run.mjs --with-setup",
    "e2e:vscode:full": "node scripts/e2e-vscode/run.mjs --with-setup --workspaces regular,monorepo",
    "bench:ide": "node scripts/ide-bench.mjs",
    "bench:ide:list": "node scripts/ide-bench.mjs --list",
    "bench:ide:quick": "node scripts/ide-bench.mjs --suite hover,formatting --server all --runs 1",
    "update-readme": "node scripts/update-readme.mjs",
    "update-memory-readme": "node scripts/update-memory-readme.mjs",
    "test:harness": "node tests/harness/run.mjs",
    "confirm": "node tests/confirm/run.mjs",
    "confirm:compile": "node tests/confirm/run.mjs --surfaces compile",
    "confirm:projection": "node tests/confirm/run.mjs --surfaces projection",
    "confirm:lint": "node tests/confirm/run.mjs --surfaces lint",
    "confirm:typecheck": "node tests/confirm/run.mjs --surfaces typecheck",
    "confirm:format": "node tests/confirm/run.mjs --surfaces format",
    "confirm:component-meta": "node tests/confirm/run.mjs --surfaces component-meta",
    "smoke": "node scripts/generate.mjs --counts 20 && node scripts/bench.mjs --fixture fixtures/20 --runs 2 --warmups 1 --surfaces compile,projection,typecheck,format,lint,component-meta,lsp,lsp-format,bundle,hmr --check-file-limit 20",
    "prepublishOnly": "node -e \"console.error('This package is private and not published to npm.'); process.exit(1)\""
  },
  "dependencies": {
    "@mrwaip/svelte-rs": "0.0.0-canary.13.1",
    "@rsvelte/compiler": "0.9.4",
    "@rsvelte/fmt": "0.7.3",
    "@rsvelte/language-server": "0.3.0",
    "@rsvelte/lint": "0.9.4",
    "@rsvelte/svelte-check": "0.5.2",
    "@rsvelte/svelte2tsx": "0.2.8",
    "@rsvelte/vite-plugin-svelte": "0.5.0",
    "@rsvelte/vite-plugin-svelte-native": "0.3.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@bufbuild/protobuf": "2.12.0",
    "@typescript-eslint/parser": "8.65.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@verter/native": "0.0.1-beta.3",
    "@verter/proto": "0.0.1-beta.3",
    "@verter/typeinfo": "0.0.1-beta.3",
    "@vscode/test-electron": "3.1.0",
    "eslint": "10.8.0",
    "eslint-plugin-svelte": "3.22.0",
    "mocha": "11.7.6",
    "oxfmt": "0.61.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "sveld": "0.36.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "svelte-check-native": "1.3.0",
    "svelte-check-rs": "0.11.0",
    "svelte-docinfo": "0.5.4",
    "svelte-language-server": "0.18.3",
    "svelte-mrwaip-reference": "npm:svelte@5.56.4",
    "svelte2tsx": "0.7.59",
    "typescript": "5.9.3",
    "typescript-go": "npm:typescript@7.0.2",
    "vite": "7.3.6",
    "zod": "4.4.3",
    "verter-lsp": "0.0.1-beta.3",
    "verter-tsc": "0.0.1-beta.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0"
}
