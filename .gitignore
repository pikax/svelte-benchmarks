# Dependencies
node_modules/
.pnpm-store/

# Generated benchmark corpora (recreate with `pnpm generate`)
/fixtures/*
!/fixtures/.gitkeep

# Pinned real-world checkouts are fetched on demand; only registry/manifest
# provenance belongs in reports, never third-party source trees.
/fixtures/real/

# Ephemeral workspaces / probe output
/work/
# bench.mjs falls back to work-<pid>-<timestamp> when Windows file locks stop it
# wiping /work/ — those fallback dirs are ephemeral too and must not be tracked.
/work-*/
/work-real/
/work-real-*/

# Local and CI report outputs stay run-local; ONLY the canonical snapshot
# directories below are committed (JSON evidence for generated docs).
/results/*
!/results/.gitkeep
!/results/README.md
!/results/benchmarks/
!/results/real_world/

# VS Code test runner download cache
.vscode-test/

# Svelte language-tools generated cache
.svelte-check/

# Tooling / OS noise
.bench-temp.json
*.tgz
*.log
.DS_Store
Thumbs.db
dist/
target/
.env
.env.*
!.env.example

# Editor / IDE
.idea/
*.swp
*.swo
